{
  "id": "girigiri-ai-dongman",
  "clientVersions": ">=6.3.0",
  "factoryId": "web-selector",
  "version": 2,
  "arguments": {
    "name": "girigiri愛動漫",
    "description": "",
    "iconUrl": "https://ani.girigirilove.com/brand/icon.png",
    "searchConfig": {
      "searchUrl": "https://m3u8.girigirilove.com/api.php/Vod/get_list?offset=0&limit=24&vod_name={keyword}",
      "rawBaseUrl": "https://bg.girigirilove.com",
      "requestInterval": 3000,
      "subjectFormatId": "json-path-indexed",
      "selectorSubjectFormatJsonPathIndexed": {
        "selectLinks": "$.info.rows[*].vod_id",
        "selectNames": "$.info.rows[*].vod_name",
        "linkTemplate": "/GV{value}/"
      },
      "channelFormatId": "index-grouped",
      "selectorChannelFormatFlattened": {
        "selectChannelNames": ".anthology-tab > .swiper-wrapper > a",
        "matchChannelName": "^(?<ch>.+?)(?:\\s*\\d+)?$",
        "selectEpisodeLists": ".anthology-list > .anthology-list-box",
        "selectEpisodesFromList": ".anthology-list-play a[href]",
        "matchEpisodeSortFromName": "^(?:第\\s*)?(?<ep>\\d+(?:\\.\\d+)?)(?:\\s*[话集])?$"
      },
      "matchVideo": {
        "enableNestedUrl": false,
        "matchNestedUrl": "",
        "matchVideoUrl": "(?i)(?:^|[?&]url=)(?<v>https?://[^?#\\s\"'<>]+?\\.(?:m3u8|mpd|mp4|m4v|mkv|webm|mov|flv|avi)(?:\\?[^#\\s\"'<>]*)?(?:#[^\\s\"'<>]*)?)(?=&|$)",
        "cookies": "",
        "addHeadersToVideo": {
          "referer": "https://ani.girigirilove.com/"
        }
      }
    },
    "tier": 0,
    "channelTiers": {
      "简中": 0,
      "繁中": 1,
      "杜比": 6
    }
  }
}
