{
  "id": "yinghua-dongman",
  "factoryId": "web-selector",
  "version": 2,
  "arguments": {
    "name": "樱花动漫",
    "description": "",
    "iconUrl": "https://cdn.l-il.cn/ajax/lucky/mxpro/images/favicon.png",
    "searchConfig": {
      "searchUrl": "https://www.yinhuadm.cc/vch/{keyword}.html",
      "searchUseOnlyFirstWord": true,
      "searchRemoveSpecial": true,
      "rawBaseUrl": "",
      "requestInterval": 3000,
      "subjectFormatId": "a",
      "selectorSubjectFormatA": {
        "selectLists": ".module-card-item-title > a",
        "preferShorterName": true
      },
      "selectorSubjectFormatIndexed": {
        "selectNames": "",
        "selectLinks": "",
        "preferShorterName": true
      },
      "selectorSubjectFormatJsonPathIndexed": {
        "selectLinks": "$[*]['url', 'link']",
        "selectNames": "$[*]['title','name']",
        "preferShorterName": true
      },
      "channelFormatId": "index-grouped",
      "selectorChannelFormatFlattened": {
        "selectChannelNames": ".module-tab-item.tab-item",
        "matchChannelName": "(?<ch>.+?)(\\d+?)",
        "selectEpisodeLists": ".module-play-list-content",
        "selectEpisodesFromList": "a.module-play-list-link",
        "selectEpisodeLinksFromList": "",
        "matchEpisodeSortFromName": "第\\s*(?<ep>.+)\\s*[话集]"
      },
      "selectorChannelFormatNoChannel": {
        "selectEpisodes": ".module-play-list-content a.module-play-list-link",
        "selectEpisodeLinks": "",
        "matchEpisodeSortFromName": "第\\s*(?<ep>.+)\\s*[话集]"
      },
      "defaultResolution": "1080P",
      "defaultSubtitleLanguage": "CHS",
      "onlySupportsPlayers": [],
      "filterByEpisodeSort": true,
      "filterBySubjectName": true,
      "selectMedia": {
        "distinguishSubjectName": true,
        "distinguishChannelName": true
      },
      "matchVideo": {
        "enableNestedUrl": true,
        "matchNestedUrl": "^https?://player\\.mcue\\.cc/.+",
        "matchVideoUrl": "(^http(s)?:\\/\\/(?!.*http(s)?:\\/\\/).+((\\.mp4)|(\\.mkv)|(\\.m3u8)).*(\\?.+)?)|(akamaized)|(bilivideo.com)|(.+\\?url=(?<v>.+(playlist\\.m3u8|\\.mp4|\\.mkv)))",
        "addHeadersToVideo": {
          "referer": "https://player.mcue.cc/",
          "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
        }
      }
    },
    "tier": 4,
    "channelTiers": {
      "Bfeng": 0,
      "Diff": 1,
      "Laoz": 1
    }
  }
}
